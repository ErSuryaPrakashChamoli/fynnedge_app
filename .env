# Which backend the app talks to. Read by lib/data/services/api_config.dart.
# Loaded with:  flutter run --dart-define-from-file=.env
# (VS Code F5 does this via .vscode/launch.json)
#
# These are compile-time values: after editing, stop the app and run it again.
# Hot reload / hot restart will NOT pick up a change.

# false = call the real API below; true = built-in sample data, no network.
FYNN_USE_MOCK=false

# --- Local: Laravel API on this computer (php artisan serve) ---
# 10.0.2.2 is this computer as seen from the Android emulator.
# On a physical phone, use this computer's LAN IP and run
# `php artisan serve --host=0.0.0.0 --port=8000`.
# FYNN_API_BASE=http://10.0.2.2:8000

# --- Production live ---
FYNN_API_BASE=http://api.fynnedge.com
